rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Products: Public menu browsing and direct admin dashboard updates
    match /products/{productId} {
      allow read, write: if true;
    }

    // Orders: Anyone can create orders; live kitchen queue sync
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Store Settings (Hero banner, store status)
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Staff Collection
    match /staff/{staffId} {
      allow read, write: if true;
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
